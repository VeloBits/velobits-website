# Velobits website — environment variables
#
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix), so they are never bundled into
# the client. They are read only by app/api/* route handlers and the server-side
# updates fetch. Copy this file to .env.local for local dev, and set the same
# values in Vercel (Production + Preview) and in the Docker runtime environment.

# The deployed Google Apps Script web app /exec URL (see apps-script/README.md).
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Shared secret — must match the Apps Script Script Property `SHARED_TOKEN`.
APPS_SCRIPT_TOKEN=replace-with-a-long-random-string
